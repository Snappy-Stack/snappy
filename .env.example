# SNAPPY STACK - Zero-Config Template Environment
# -----------------------------------------------

# 1. PRIMARY LICENSE KEY (The only thing needed for D1/R2)
SNAPPY_LICENSE_TOKEN=your_license_here
SNAPPY_API_URL=https://snappycore.wicky.id

# 2. PAYLOAD CMS
PAYLOAD_SECRET=generate_a_random_secret_here
PUBLIC_FRONTEND_URL=http://localhost:3000

# 3. STORAGE (R2/S3)
# These are still required for the S3 Plugin, but the prefix is managed by SNAPPY.
S3_BUCKET=snappy-production
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_REGION=auto
S3_ENDPOINT=https://your-r2-endpoint.cloudflare.com
